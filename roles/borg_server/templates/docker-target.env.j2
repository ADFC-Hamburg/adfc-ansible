# {{ ansible_managed }}
#
# Zielserver "{{ backup_client }}" (docker-borg-backup-server auf
# {{ hostvars[backup_client].ansible_host }}, siehe
# roles/borg_backup_target_docker). BORG_SSH_USER ist immer "borg" - der
# Server hat dafuer genau diesen einen Systemuser, Auth laeuft ueber den
# Key/Forced-Command, nicht ueber den Usernamen.

BORG_SSH_USER=borg
BORG_SSH_HOST={{ hostvars[backup_client].ansible_host }}
BORG_SSH_PORT={{ hostvars[backup_client].adfc_borg_target_ssh_port | default(2222) }}
BORG_REPO_PATH=/data/{{ inventory_hostname_short }}
BORG_REMOTE_PATH=borg
ARCHIVE_PREFIX={{ inventory_hostname_short }}

BACKUP_SOURCE_DIRS="{{ borg_save_path | trim }}"

BORG_CREATE_EXTRA_ARGS="--exclude-caches --numeric-owner --noatime{% for dir in borg_save_exclude_dirs | default([]) %} -e {{ dir }}{% endfor %}"
{% if borg_create_pre_job | default('') != '' %}

PRE_BACKUP_HOOK={{ adfc_borg_docker_dir }}/pre-backup-hook.sh
{% endif %}
