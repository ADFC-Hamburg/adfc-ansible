# {{ ansible_managed }}
#
# Zielserver "{{ backup_client }}" (docker-borg-backup-server auf
# {{ hostvars[backup_client].ansible_host }}, siehe
# roles/borg_backup_target_docker). Seit Server-Version 1.1.0 hat jede
# registrierte Identitaet ihren eigenen Unix-Account statt eines
# gemeinsamen "borg"-Users (Multi-User-Isolation, siehe dessen
# Release-Notes) - der Username ist deshalb der Identitaetsname, mit dem
# dieser Quellhost per add-backup-key.sh registriert wurde (siehe
# setup_client_docker_target.yml, adfc_borg_docker_uid).

BORG_SSH_USER={{ inventory_hostname_short }}
BORG_SSH_HOST={{ hostvars[backup_client].ansible_host }}
BORG_SSH_PORT={{ hostvars[backup_client].adfc_borg_target_ssh_port | default(2222) }}

# Zielboxen haben Dual-Stack-DynDNS-Namen, deren AAAA-Eintrag fuer den
# Docker-Port meist nicht erreichbar ist (Docker published Ports i.d.R.
# nur auf IPv4) - docker-borg-backup >=v1.1.0-rc1 kann das selbst per -4
# umgehen (ssh-keyscan, BORG_RSH), siehe dessen Release-Notes.
TARGET_IPV4_ONLY={{ hostvars[backup_client].adfc_borg_target_ipv4_only | default(true) | lower }}

BORG_REPO_PATH=/data/{{ inventory_hostname_short }}
BORG_REMOTE_PATH=borg
ARCHIVE_PREFIX={{ inventory_hostname_short }}

BACKUP_SOURCE_DIRS="{{ borg_save_path | trim }}"

# docker-borg-backup mountet jeden Eintrag aus BACKUP_SOURCE_DIRS einzeln
# unter /source/<sanitized-name>/ (siehe sanitize_source_name() in dessen
# backup.sh bzw. borg_backup_plain() in adfc-borg-docker.j2) statt wie beim
# alten adfc-borg-pyenv den Host-Pfad direkt zu sichern - Excludes mit
# fuehrendem "/" (z.B. "/sys", "/srv/docker-rocket/...") muessen deshalb auf
# den jeweiligen Mountpoint umgeschrieben werden, sonst greifen sie nicht
# (borg_save_exclude_dirs bleibt fuer adfc-borg-pyenv unveraendert - siehe
# adfc-borg-pyenv.j2). Glob-Muster wie "*/ImapMail" sind unverankert und
# brauchen kein Remapping.
BORG_CREATE_EXTRA_ARGS="--exclude-caches --numeric-ids{% if borg_docker_create_extra_args | default('') != '' %} {{ borg_docker_create_extra_args }}{% endif %}{% for dir in borg_save_exclude_dirs | default([]) | docker_source_excludes((borg_save_path | trim).split()) %} -e {{ dir }}{% endfor %}"
{% if borg_create_pre_job | default('') != '' %}

PRE_BACKUP_HOOK={{ adfc_borg_docker_dir }}/pre-backup-hook.sh
{% endif %}
