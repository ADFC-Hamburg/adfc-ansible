# {{ ansible_managed }}
SSH_PORT={{ adfc_borg_target_ssh_port }}

# Server-Default ist nur "ssh-ed25519,sk-ssh-ed25519@openssh.com" - die
# meisten registrierten Admin-Keys (ssh_keys/<name>/*.pub) sind aber noch
# RSA. rsa-sha2-512/256 statt des veralteten/unsicheren "ssh-rsa"-SHA1.
SSHD_PUBKEY_ALGORITHMS={{ adfc_borg_target_ssh_pubkey_algorithms }}

# Server-Default ist 3 - reicht nicht, wenn ein Admin-Key im ssh-agent
# nicht das erste Angebot ist (admin-compact.sh/admin-shell.sh bieten
# IMMER alle Keys aus dem Agent an, docker-borg-backup unterstuetzt kein
# gezieltes "-i <key> -o IdentitiesOnly=yes"). Bei mehreren Keys im Agent
# (v.a. Hardware-Token, die zusaetzlich noch eine Touch-Bestaetigung
# brauchen) sonst "Permission denied (publickey)", obwohl ein gueltiger
# Key spaeter im Agent gestanden haette.
SSHD_MAX_AUTH_TRIES={{ adfc_borg_target_ssh_max_auth_tries }}
